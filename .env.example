# Database (docker compose maps Postgres to host port 5433)
DATABASE_URL=postgresql://hr:hr@localhost:5433/hr

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Signs API access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=28800
# Where uploaded documents are stored (local driver; S3/Supabase in deployment)
STORAGE_DIR=storage

# Web (Auth.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Encrypts the Auth.js session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# AI service (apps/ai, FastAPI). Uses WEB_ORIGIN above for CORS.
HR_API_URL=http://localhost:4000
AI_PORT=8000

# LLM: any free OpenAI-compatible API. Only the AI service reads these.
# Switch provider by changing LLM_PROVIDER and LLM_MODEL; each uses its own key below.
#   groq        GROQ_API_KEY        https://console.groq.com/keys
#   openrouter  OPENROUTER_API_KEY  https://openrouter.ai/settings/keys  (free models end in ":free")
#   gemini      GEMINI_API_KEY      https://aistudio.google.com/apikey
#   custom      LLM_BASE_URL + LLM_API_KEY (LLM_API_KEY is also the fallback for the others)
# Pick LLM_MODEL from `cd apps/ai && uv run hr-ai models` (free-tier lists change).
# Only synthetic data: free tiers may train on what you send.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Tracing (M3): Langfuse Cloud free tier, https://cloud.langfuse.com → project settings → API keys.
# Leave empty to keep traces local. Traces are masked (tokens, emails, phones, names) before export.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
