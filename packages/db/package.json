{
  "name": "@hr/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed, and generated client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hr/config": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
