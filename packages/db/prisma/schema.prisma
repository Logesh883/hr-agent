// HR Operations — core schema. Enum values mirror @hr/contracts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR_OPS
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  OFFER_LETTER
  ID_PROOF
  ADDRESS_PROOF
  PAN_CARD
  BANK_DETAILS
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  PHOTO
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum OnboardingTaskStatus {
  PENDING
  DONE
  SKIPPED
}

enum OnboardingCategory {
  PAPERWORK
  DOCUMENTS
  IT_SETUP
  ORIENTATION
  TEAM
}

enum OnboardingAssignee {
  HR
  MANAGER
  EMPLOYEE
  IT
}

/// Login account. Linked to an Employee record when the user is also staff.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  employeeId   String?   @unique @db.Uuid
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leaveRequested    LeaveRequest[]   @relation("LeaveRequestedBy")
  leaveDecided      LeaveRequest[]   @relation("LeaveDecidedBy")
  documentsUploaded Document[]       @relation("DocumentUploadedBy")
  documentsReviewed Document[]       @relation("DocumentReviewedBy")
  onboardingDone    OnboardingTask[]
}

model Department {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String                   @unique
  code                String                   @unique
  status              DepartmentStatus         @default(ACTIVE)
  managerId           String?                  @db.Uuid
  manager             Employee?                @relation("DepartmentManager", fields: [managerId], references: [id])
  employees           Employee[]               @relation("DepartmentEmployees")
  onboardingTemplates OnboardingTemplateTask[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  employeeCode       String           @unique
  firstName          String
  lastName           String
  email              String           @unique
  phone              String?
  dateOfBirth        DateTime?        @db.Date
  jobTitle           String
  location           String
  joiningDate        DateTime         @db.Date
  employmentType     EmploymentType
  status             EmployeeStatus   @default(PROBATION)
  departmentId       String           @db.Uuid
  department         Department       @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managerId          String?          @db.Uuid
  manager            Employee?        @relation("ManagerReports", fields: [managerId], references: [id])
  reports            Employee[]       @relation("ManagerReports")
  managedDepartments Department[]     @relation("DepartmentManager")
  user               User?
  leaveRequests      LeaveRequest[]
  documents          Document[]
  onboardingTasks    OnboardingTask[]
  /// Optimistic locking: incremented on every update.
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@index([lastName, firstName])
}

/// Append-only record of every mutation, by a human or the AI agent.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String
  entityType String
  entityId   String    @db.Uuid
  before     Json?
  after      Json?
  timestamp  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([timestamp])
}

/// Named counters for human-readable codes (e.g. EMP-0001).
model Counter {
  name  String @id
  value Int
}

model LeaveRequest {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String      @db.Uuid
  employee        Employee    @relation(fields: [employeeId], references: [id])
  type            LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  /// Working days at the time of the request (weekends and holidays excluded).
  days            Int
  reason          String?
  status          LeaveStatus @default(PENDING)
  requestedById   String      @db.Uuid
  requestedBy     User        @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  /// Approver or rejector (spec: approverId).
  decidedById     String?     @db.Uuid
  decidedBy       User?       @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
}

/// Company-wide non-working days.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

/// Employee document. The file lives in object storage under storageKey.
model Document {
  id           String         @id @default(uuid()) @db.Uuid
  employeeId   String         @db.Uuid
  employee     Employee       @relation(fields: [employeeId], references: [id])
  type         DocumentType
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String         @unique
  status       DocumentStatus @default(PENDING)
  uploadedById String         @db.Uuid
  uploadedBy   User           @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now())
  /// Last verify/flag decision (spec: verifiedAt).
  reviewedById String?        @db.Uuid
  reviewedBy   User?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  /// Structured fields extracted by the AI agent's OCR pipeline (AI scope).
  extraction   Json?

  @@index([employeeId])
  @@index([status])
}

/// Checklist item copied into every new hire's onboarding (department-specific when departmentId is set).
model OnboardingTemplateTask {
  id                   String             @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  category             OnboardingCategory
  assignee             OnboardingAssignee
  /// Due relative to the joining date (negative = before day one).
  dueOffsetDays        Int
  departmentId         String?            @db.Uuid
  department           Department?        @relation(fields: [departmentId], references: [id])
  requiredDocumentType DocumentType?
  sortOrder            Int
  createdAt            DateTime           @default(now())
}

/// One onboarding checklist item for one employee (spec: taskType = category).
model OnboardingTask {
  id                   String               @id @default(uuid()) @db.Uuid
  employeeId           String               @db.Uuid
  employee             Employee             @relation(fields: [employeeId], references: [id])
  templateTaskId       String?              @db.Uuid
  title                String
  description          String?
  category             OnboardingCategory
  assignee             OnboardingAssignee
  dueDate              DateTime             @db.Date
  status               OnboardingTaskStatus @default(PENDING)
  requiredDocumentType DocumentType?
  sortOrder            Int
  completedAt          DateTime?
  completedById        String?              @db.Uuid
  completedBy          User?                @relation(fields: [completedById], references: [id])
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([employeeId])
}
