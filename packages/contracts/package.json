{
  "name": "@hr/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared DTOs, zod schemas, permissions, and tool contracts for the HR API, web app, and AI agent",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "schemas:export": "pnpm build && node scripts/export-json-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hr/config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
