{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LoginRequest": {
      "title": "LoginRequest",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "ChangePassword": {
      "title": "ChangePassword",
      "type": "object",
      "properties": {
        "currentPassword": {
          "type": "string",
          "minLength": 1
        },
        "newPassword": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "[A-Za-z]"
            },
            {
              "pattern": "\\d"
            }
          ]
        }
      },
      "required": [
        "currentPassword",
        "newPassword"
      ]
    },
    "GrantAccess": {
      "title": "GrantAccess",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "ADMIN",
            "HR_OPS",
            "MANAGER",
            "EMPLOYEE"
          ]
        }
      },
      "required": [
        "role"
      ]
    },
    "UpdateAccess": {
      "title": "UpdateAccess",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "ADMIN",
            "HR_OPS",
            "MANAGER",
            "EMPLOYEE"
          ]
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "DailyAttendanceQuery": {
      "title": "DailyAttendanceQuery",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "departmentId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "date"
      ]
    },
    "MonthlyAttendanceQuery": {
      "title": "MonthlyAttendanceQuery",
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "departmentId": {
          "type": "string",
          "format": "uuid"
        },
        "employeeId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "month"
      ]
    },
    "ProposeCorrection": {
      "title": "ProposeCorrection",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "PRESENT",
            "HALF_DAY",
            "ABSENT"
          ]
        },
        "checkIn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkOut": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "employeeId",
        "date",
        "status",
        "reason"
      ]
    },
    "ApproveCorrection": {
      "title": "ApproveCorrection",
      "type": "object",
      "properties": {
        "comment": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "RejectCorrection": {
      "title": "RejectCorrection",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "reason"
      ]
    },
    "CorrectionSearchQuery": {
      "title": "CorrectionSearchQuery",
      "type": "object",
      "properties": {
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "employeeId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "AuditSearchQuery": {
      "title": "AuditSearchQuery",
      "type": "object",
      "properties": {
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "entityType": {
          "type": "string",
          "enum": [
            "Employee",
            "Department",
            "LeaveRequest",
            "Document",
            "OnboardingTask",
            "AttendanceRecord",
            "AttendanceCorrection",
            "PolicyDocument",
            "User"
