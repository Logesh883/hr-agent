        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "PublishPolicy": {
      "title": "PublishPolicy",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "LEAVE",
            "ATTENDANCE",
            "CONDUCT",
            "ONBOARDING",
            "BENEFITS",
            "PAYROLL",
            "IT_SECURITY",
            "OTHER"
          ]
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "title",
        "category",
        "effectiveFrom"
      ]
    },
    "CreateDepartment": {
      "title": "CreateDepartment",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{2,10}$"
        },
        "managerId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
