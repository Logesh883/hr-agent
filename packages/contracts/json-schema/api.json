    "DocumentSearchQuery": {
      "title": "DocumentSearchQuery",
      "type": "object",
      "properties": {
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "employeeId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "VERIFIED",
            "FLAGGED"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "OFFER_LETTER",
            "ID_PROOF",
