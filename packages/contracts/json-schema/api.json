        "jobTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "departmentId": {
          "type": "string",
          "format": "uuid"
        },
        "managerId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "joiningDate": {
          "type": "string",
          "format": "date"
        },
        "employmentType": {
          "type": "string",
          "enum": [
            "FULL_TIME",
            "PART_TIME",
            "CONTRACT",
            "INTERN"
          ]
        },
        "status": {
          "default": "PROBATION",
          "type": "string",
          "enum": [
            "ACTIVE",
            "PROBATION"
          ]
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "jobTitle",
        "departmentId",
        "location",
        "joiningDate",
        "employmentType"
