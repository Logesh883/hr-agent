        },
        "employmentType": {
          "type": "string",
          "enum": [
            "FULL_TIME",
            "PART_TIME",
            "CONTRACT",
            "INTERN"
          ]
        },
        "status": {
          "default": "PROBATION",
          "type": "string",
          "enum": [
            "ACTIVE",
            "PROBATION"
          ]
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "jobTitle",
        "departmentId",
        "location",
        "joiningDate",
        "employmentType"
      ]
